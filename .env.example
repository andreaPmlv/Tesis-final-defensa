# Example environment variables for tesis-finaldefensa
# Copy this file to .env and fill values before running the backend

# Mail / SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=youremail@example.com
MAIL_PASSWORD=your-email-password-or-app-password
MAIL_DEFAULT_NAME=IsoScore Admin
MAIL_DEFAULT_SENDER=youremail@example.com

# Flask secret key
SECRET_KEY=change_this_to_a_secure_random_value

# Database (SQLite example)
# For sqlite use e.g. sqlite:///./isoscore.db
DATABASE_URL=sqlite:///${PWD}/app-tesis/isoscore.db

# Frontend base URL (for CORS)
FRONTEND_BASE_URL=http://localhost:4200
